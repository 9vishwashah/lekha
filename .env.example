# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app, used to build share and invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (dashboard.clerk.com -> API keys). In local development Clerk can also run keyless.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (project settings -> API). Only the publishable key is used; no service-role key is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 32 random bytes, base64. Encrypts share-link tokens so owners can copy a link again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHARE_LINK_SECRET=replace-with-32-random-bytes-base64

# Playwright end-to-end tests (Clerk testing tokens + two test users in your dev instance)
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# Optional: run the end-to-end tests against a deployed Vercel preview instead of a local server.
# The preview must use the Clerk development keys (the test users live there).
E2E_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Email through Resend (https://resend.com). Verify your domain in Resend first.
RESEND_API_KEY=
# The sender, on that verified domain. Emails show as "<Business> via Lekha <address>".
EMAIL_FROM=Lekha <notify@lekha.vjas.in>
# Guards the daily email job (/api/cron/email). Vercel Cron sends it automatically.
# Use 32+ random characters, and set the same value in the database once:
#   select app.set_cron_secret('<same value>');
CRON_SECRET=
